  m_Script: {fileID: 11500000, guid: f4ff683893bac9746af2ea0c678c1c78, type: 3}
  m_Name: Reception
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  dialogues:
  - characterName: Receptionist Mel
    characterArt: {fileID: 21300000, guid: f44577708d38d0840bbaa538ca1642ca, type: 3}
    speech:
    - Why must you always keep the blinds on the doors closed? I want to see the
      sun!
  - characterName: Receptionist Greg
    characterArt: {fileID: 21300000, guid: 794dd41368b2b7f4bb1928c2475f7e63, type: 3}
    speech:
    - Because! There's a glare and I can't see my phone screen well.
  - characterName: Receptionist Mel
    characterArt: {fileID: 21300000, guid: f44577708d38d0840bbaa538ca1642ca, type: 3}
    speech:
    - Stop playing those stupid games at work!
  - characterName: Receptionist Greg
    characterArt: {fileID: 21300000, guid: 794dd41368b2b7f4bb1928c2475f7e63, type: 3}
    speech:
    - Watch out! Mr. MMA is here. Bet the mailman is happy he won't see you again.
